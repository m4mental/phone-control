<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneControl">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FreezerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".GameTurboActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".SuperDozeActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ModeControlActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".PerAppActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".BatteryActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".BatteryHealthActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ChargingProtectionActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".SensorFirewallActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".GameTurboSuiteActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AppFreezerListActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".RefreshRateActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".StudioEqualizerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ForceDozeActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".StandbyGuardActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".TcpBbrActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".OptimizationActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AdbShellActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".StandbyWhitelistActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ScalingWhitelistActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".FirewallActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AppInspectorActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AppBackupListActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AppRestoreListActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".HomeTowerLockActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />


        <service
            android:name=".BackupService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <activity
            android:name=".DozeWhitelistActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ThrottlingActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".RamActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".NetworkActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ResolutionActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".BloatwareActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />



        <service
            android:name=".AutoTweakService"
            android:exported="false" />

        <service
            android:name=".AppEventService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>



        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Audio Effect Control Session Receiver for System-wide Background Music Players -->
        <receiver
            android:name=".AudioEffectSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CooldownTileService"
            android:exported="true"
            android:label="Emergency Cooldown"
            android:icon="@android:drawable/ic_dialog_alert"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Mode Control QS Tile (1-Tap Cycle: AI Auto -> Balanced -> Power Saver -> Performance) -->
        <service
            android:name=".ModeControlTileService"
            android:exported="true"
            android:label="Operating Mode"
            android:icon="@drawable/ic_qs_mode_control"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Standard Freezer Widget (All Frozen Apps) -->
        <receiver android:name=".FreezerWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.phonecontrol.ACTION_LAUNCH_APP" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/freezer_widget_info" />
        </receiver>

        <service android:name=".FreezerWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Special Freezer Widget (Custom Choice Special Freeze Apps Only) -->
        <receiver android:name=".SpecialFreezerWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.phonecontrol.ACTION_LAUNCH_SPECIAL_APP" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/special_freezer_widget_info" />
        </receiver>

        <service android:name=".SpecialFreezerWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>