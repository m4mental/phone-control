<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneControl">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FreezerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ModeControlActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".PerAppActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".BatteryActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".OptimizationActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".AdbShellActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />


        <activity
            android:name=".DozeWhitelistActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ThrottlingActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".RamActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".NetworkActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".ResolutionActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />

        <activity
            android:name=".BloatwareActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneControl" />



        <service
            android:name=".AutoTweakService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />



        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CooldownTileService"
            android:exported="true"
            android:label="Emergency Cooldown"
            android:icon="@android:drawable/ic_dialog_alert"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Freezer Widget -->
        <receiver android:name=".FreezerWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.phonecontrol.ACTION_LAUNCH_APP" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/freezer_widget_info" />
        </receiver>

        <service android:name=".FreezerWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>