<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRam"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="RAM &amp; ZRAM Engine"
        app:titleTextColor="@color/color_ram"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/color_ram" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="High-speed compressed Physical RAM Engine. Keeps 25+ background apps alive without killing them, slowing down UFS storage, or causing gaming stutters."
                android:textColor="#AAAAAA" android:textSize="13sp" android:layout_marginBottom="16dp" />

            <!-- 1-Tap Instant ZRAM Compactor -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#121212" app:strokeWidth="1dp" app:strokeColor="#1E3A5F">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" text="Instant RAM Compactor" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" text="Defragments compressed swap pages in kernel memory to instantly reclaim 200MB - 600MB RAM without closing any running apps." android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvCompactionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready for 0ms memory compaction"
                        android:textColor="#448AFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompactRam"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="🧹 INSTANT 1-TAP RAM COMPACT"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:backgroundTint="#1565C0"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZRAM Compression Algorithm Selection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#121212" app:strokeWidth="1dp" app:strokeColor="#333333">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compression Algorithm" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select compression engine: LZ4 for fastest speed, or ZSTD for holding the maximum number of apps." android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp" />
                    <RadioGroup android:id="@+id/rgZramAlgo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbAlgoLz4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LZ4 (Ultra Fast — Zero Latency Gaming)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbAlgoZstd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ZSTD (High Density — 35% Higher App Hold)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Multitasking Profile -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#121212" app:strokeWidth="1dp" app:strokeColor="#333333">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Multitasking &amp; Swappiness Profile" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kernel VM tuning: Controls how aggressively inactive apps are compressed into ZRAM." android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp" />
                    <RadioGroup android:id="@+id/rgRamProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbProfileBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Balanced (swappiness=100 • Daily Smooth)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbProfileMultitasking" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aggressive Multitasking (swappiness=160 • Hold 25+ Apps)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbProfilePerformance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ultra Snappy / Gaming (swappiness=30 • Lowest Overhead)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZRAM Size -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="#121212" app:strokeWidth="1dp" app:strokeColor="#333333">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZRAM Disk Size" android:textColor="#FFFFFF" android:textStyle="bold" />
                    <RadioGroup android:id="@+id/rgZramSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <RadioButton android:id="@+id/rbZramOff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disabled (Pure Physical RAM)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbZram2G" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2GB (Light)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbZram4G" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4GB (Standard)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                        <RadioButton android:id="@+id/rbZram8G" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="8GB (Recommended on Nothing OS)" android:textColor="#FFFFFF" android:buttonTint="@color/color_ram" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyRam"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginBottom="24dp" android:text="APPLY RAM &amp; ZRAM SETTINGS"
                android:textColor="@android:color/black" android:textStyle="bold"
                app:backgroundTint="@color/color_ram" app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
