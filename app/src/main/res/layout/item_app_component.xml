<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#121214"
    android:layout_marginBottom="1dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvComponentSimpleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ComponentName"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvComponentTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="SERVICE"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#162E38"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/tvBootBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="⚡ BOOT"
                android:textColor="#FF9100"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#331D00"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrackerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="📡 TRACKER"
                android:textColor="#E040FB"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#2E0E38"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvComponentFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.example.app.service.MyService"
            android:textColor="#777777"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchComponent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@android:color/white"
        app:trackTint="#00E676" />

</LinearLayout>
