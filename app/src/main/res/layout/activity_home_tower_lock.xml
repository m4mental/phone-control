<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTower"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Home 5G Tower Lock"
        app:titleTextColor="#00BFA5"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#00BFA5" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Live Tower Scanner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#001815"
                app:strokeWidth="1dp"
                app:strokeColor="#00BFA5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live Cell Tower Scanner"
                            android:textColor="#00BFA5"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualScan"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCAN NOW 🔄"
                            android:textColor="#00BFA5"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:layout_marginTop="8dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connected Network" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLiveRat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scanning..." android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Serving Cell PCI" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLivePci" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PCI: --" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Channel (EARFCN/NR)" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLiveEarfcn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EARFCN: --" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Signal Strength (RSRP)" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLiveRsrp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- dBm" android:textColor="#00E676" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Signal Quality (RSRQ)" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLiveRsrq" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- dB" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Operator" android:textColor="#888888" android:textSize="11sp" />
                            <TextView android:id="@+id/tvLiveCarrier" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#40C4FF" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: 5G Modem Anti-Sleep (Keep-Alive) Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#121212"
                app:strokeWidth="1dp"
                app:strokeColor="#333333">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5G Modem Anti-Sleep (Keep-Alive)"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Prevents baseband modem from sleeping or down-shifting during standby, maintaining zero-latency connection."
                            android:textColor="#888888"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAntiSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Home Tower Lock Controls -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home Tower Lock &amp; Roaming Control"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Locks modem strictly to your saved indoor mast. Prevents cell hopping and ping spikes."
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#121212"
                app:strokeWidth="1dp"
                app:strokeColor="#333333">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSavedHomeInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saved Home Tower: Not Configured"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLockStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🔵 AUTOMATIC ROAMING (OUTDOOR)"
                        android:textColor="#00C853"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#222222"
                        android:layout_marginVertical="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveHomeTower"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="SAVE CURRENT"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#1A1A1A"
                            app:strokeWidth="1dp"
                            app:strokeColor="#555555"
                            app:cornerRadius="8dp" />
                        <View android:layout_width="8dp" android:layout_height="0dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLockHome"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="LOCK TO SAVED"
                            android:textColor="@android:color/black"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#00BFA5"
                            app:cornerRadius="8dp" />
                        <View android:layout_width="8dp" android:layout_height="0dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReleaseLock"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="RELEASE"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#B71C1C"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Manual Tower Input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#121212"
                app:strokeWidth="1dp"
                app:strokeColor="#333333">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manual Tower Configuration"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etManualPci"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="#1A1A1A"
                            android:hint="PCI (e.g. 142)"
                            android:inputType="number"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:paddingHorizontal="12dp" />
                        <View android:layout_width="8dp" android:layout_height="0dp" />
                        <EditText
                            android:id="@+id/etManualEarfcn"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="#1A1A1A"
                            android:hint="EARFCN (e.g. 39150)"
                            android:inputType="number"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyManualLock"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="APPLY MANUAL TOWER LOCK"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:backgroundTint="#00695C"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 5: Detected Nearby Towers List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detected Nearby Cell Towers"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutTowerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
