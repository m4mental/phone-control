<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Active FGS Immunity Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImmunityInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#121820"
        app:strokeWidth="1dp"
        app:strokeColor="#1F3A4A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/stat_sys_download"
                    app:tint="#00E5FF"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active FGS &amp; Download Guard"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allows Normal Freezer apps to stay active in background ONLY while actively downloading or running foreground services. Once finished, they hibernate automatically."
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔒 Note: Special Freezer apps are hard-isolated and cannot receive FGS immunity."
                android:textColor="#FF8A80"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableAllImmunity"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grant All"
                    android:textColor="#00E5FF"
                    app:backgroundTint="#1B2834"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisableAllImmunity"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Revoke All"
                    android:textColor="#AAAAAA"
                    app:backgroundTint="#202024"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvImmunityTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Normal Freezer Apps (Per-App Permission)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEmptyStateImmunity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No apps in Normal Freezer.\nAdd apps in the 'Normal Freezer' tab first to configure download immunity."
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
