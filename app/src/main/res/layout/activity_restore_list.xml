<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRestoreList"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Restore Backups"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@android:color/white" />

    <EditText
        android:id="@+id/etSearchRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search backed up apps..."
        android:textColor="@android:color/white"
        android:textColorHint="#555555"
        android:padding="12dp"
        android:background="#161616"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:inputType="text" />

    <!-- Top Multi-Selection & Batch Delete Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:background="#121212"
        android:layout_marginTop="8dp">

        <CheckBox
            android:id="@+id/cbSelectAllRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:buttonTint="#00C853" />

        <TextView
            android:id="@+id/tvSelectedRestoreCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 selected"
            android:textColor="#888888"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSelectedBackups"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🗑️ DELETE"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvRestoreBackups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1E1E1E"
        android:dividerHeight="1dp" />

    <!-- Bottom Batch Restore Action Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#121212">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreSelected"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🔄 RESTORE SELECTED (0 APPS)"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            app:backgroundTint="#00C853"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
