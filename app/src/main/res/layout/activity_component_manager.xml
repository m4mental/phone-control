<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComponentManager"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="App Component Manager"
        app:titleTextColor="#00E5FF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#00E5FF" />

    <!-- App Selected Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#141418"
        app:strokeWidth="1dp"
        app:strokeColor="#252530">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivSelectedAppIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/sym_def_app_icon"
                android:contentDescription="Selected App Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select an Application"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSelectedAppPackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap 'Change App' to inspect components"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeApp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="CHANGE"
                android:textSize="11sp"
                android:textColor="#00E5FF"
                app:strokeColor="#00E5FF"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Batch Action Buttons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockBoot"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🛡️ BLOCK BOOT RECEIVERS"
                android:textSize="11sp"
                android:backgroundTint="#331D00"
                android:textColor="#FF9100"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockTrackers"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🚫 BLOCK TRACKERS"
                android:textSize="11sp"
                android:backgroundTint="#2E0E38"
                android:textColor="#E040FB"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetAll"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔄 RESET ALL"
                android:textSize="11sp"
                android:backgroundTint="#191924"
                android:textColor="#AAAAAA"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearchComponent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search component or class name..."
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:background="#191920"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupComponents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All (0)"
                    android:checked="true"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompBoot"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Boot Receivers (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompTrackers"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 Trackers (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompServices"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Services (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompReceivers"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📻 Receivers (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompDisabled"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛑 Disabled (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvComponentCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading components..."
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvComponents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/pbComponentLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="No components found."
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
