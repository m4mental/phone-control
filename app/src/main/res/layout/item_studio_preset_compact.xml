<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_preset_item_ripple"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivPresetIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_qs_preset"
        app:tint="#94A3B8"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPresetItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dimensional 3D Theater"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPresetItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Bands • Cinema Acoustics"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPresetCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="#00E5FF"
        android:visibility="gone" />

</LinearLayout>
