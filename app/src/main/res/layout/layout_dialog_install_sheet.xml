<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121214"
    android:padding="20dp">

    <!-- Top Header: Icon, Name, Main Package, Shared UID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivInspectIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInspectAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Application Name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInspectPkgName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="com.example.package"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Shared User ID (if app defines one) -->
            <TextView
                android:id="@+id/tvInspectSharedUid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared UID: android.uid.system"
                android:textColor="#FFB74D"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Version Comparison Card: Installed vs Incoming Update -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#191920"
        android:padding="12dp"
        android:orientation="vertical">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvInspectInstallType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🆕 Fresh Installation"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Currently Installed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTALLED VERSION"
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInspectInstalledVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not Installed"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Incoming Update -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCOMING VERSION"
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInspectIncomingVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0 (Build 1)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Sub-Packages / Split Modules (When APK is a bundle or has splits) -->
    <LinearLayout
        android:id="@+id/layoutInspectSplits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#16181F"
        android:padding="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInspectSplitsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 BUNDLED SUB-PACKAGES &amp; SPLITS"
            android:textColor="#81D4FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInspectSplits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="base, config.arm64_v8a, config.xxhdpi"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- SDK Compatibility Row: Min SDK, Target SDK, Max SDK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1A1A20"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIN SDK"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInspectMinSdk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 23\n(Android 6.0)"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1A1A20"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET SDK"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInspectTargetSdk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 35\n(Android 15)"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1A1A20"
            android:padding="8dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX SDK"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInspectMaxSdk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Limit\n(All Versions)"
                android:textAlignment="center"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secondary Specs Row: Size and Package Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#16161D"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILE SIZE"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInspectSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- MB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#16161D"
            android:padding="8dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PACKAGE TYPE"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvInspectPackageType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single APK"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Privacy & Trackers Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#16161C"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ PRIVACY &amp; TRACKER AUDIT"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInspectTrackers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scanning for trackers..."
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22222A"
            android:layout_marginVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 SENSITIVE PERMISSIONS"
            android:textColor="#FFD600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInspectPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Checking permissions..."
            android:textColor="#DDDDDD"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnInspectCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#AAAAAA"
            android:backgroundTint="#222228"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnInspectInstall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="⚡ Install with Root"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676" />
    </LinearLayout>

</LinearLayout>
