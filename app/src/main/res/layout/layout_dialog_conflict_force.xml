<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121214"
    android:padding="20dp">

    <!-- Header Banner: Stoppage detected -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2E1414"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConflictHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Installation Stoppage Detected"
                android:textColor="#FF5252"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConflictHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android prevented this update from applying normally"
                android:textColor="#FFCDD2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Diagnosis & Root Cause Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#1A1A22"
        android:padding="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 WHY DID THE UPDATE STOP?"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConflictReasonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Signature Mismatch Conflict"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConflictReasonExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="The APK signature does not match the app currently installed on your device. Android blocks overwriting apps with different developer keys to prevent tampering."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Version & Target Comparison -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#16161D"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP COMPARISON"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConflictAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Installed: v2.0.0 (Build 20)  ➔  Incoming: v1.9.0 (Build 19)"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Zero Data Loss Guarantee Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#162E20"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ ZERO DATA LOSS GUARANTEE"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Before cleanly reinstalling, PhoneControl will automatically archive your existing app data (/data/data) to storage so you can restore all accounts and databases in 1-click right after install."
            android:textColor="#C8E6C9"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Action Buttons: Cancel vs Force Install -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnConflictCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#AAAAAA"
            android:backgroundTint="#24242C"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnConflictProceed"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="⚡ Force Install (Safe)"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#FFD600" />
    </LinearLayout>

</LinearLayout>
