<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_hud"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="12dp">

    <!-- Top Bar: Mode & Close Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/hudDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="#00E5FF"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvHudMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Loading..."
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnHudClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="14dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Metrics Bar: Little Cores | Big Cores | Temp -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvHudLittleFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L: --- MHz"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#555555"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvHudBigFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B: --- MHz"
            android:textColor="#FF9100"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#555555"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvHudTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textColor="#76FF03"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
