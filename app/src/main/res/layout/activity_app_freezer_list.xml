<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAppFreezerList"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="App Freezer &amp; Hibernation"
        app:titleTextColor="@color/color_freezer"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/color_freezer" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutFreezer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#161618"
        app:tabIndicatorColor="#00E5FF"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#00E5FF"
        app:tabTextColor="#8E8E93"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <HorizontalScrollView
        android:id="@+id/scrollFreezerFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#101010">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFreezerFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreezerAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL"
                android:textColor="@android:color/white"
                android:checked="true"
                app:chipBackgroundColor="#222222" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreezerMain"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 MAIN"
                android:textColor="#00BFA5"
                app:chipBackgroundColor="#1A2E2B" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreezerDual"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 DUAL / CLONE"
                android:textColor="#FF9800"
                app:chipBackgroundColor="#2E231A" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreezerPrivate"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 PRIVATE SPACE"
                android:textColor="#E91E63"
                app:chipBackgroundColor="#2E1A23" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerFreezer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
