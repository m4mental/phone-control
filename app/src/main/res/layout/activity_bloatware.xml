<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBloat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Bloatware Remover"
        app:titleTextColor="@color/color_bloat"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/color_bloat" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Easily disable system bloatware to free up RAM and CPU resources. Removed apps can be restored using 'pm enable'."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etSearchBloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search system apps..."
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvBloatApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#222222"
        android:dividerHeight="1dp" />

</LinearLayout>
