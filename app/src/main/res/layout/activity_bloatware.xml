<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBloat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="UAD-NG Debloater &amp; Bloat Cleaner"
        app:titleTextColor="#00E5FF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#00E5FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvBloatSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UAD-NG curated safe debloater. Disable carrier &amp; vendor bloatware with 1-tap and full Undo safety."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSearchBloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search apps or package names..."
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:background="#191920"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Main Category Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupBloatTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabUad"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ UAD-NG Debloater"
                    android:checked="true"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabSystem"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All System Apps"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabDisabled"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disabled Apps (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTabUndo"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏪ Undo History (0)"
                    app:chipBackgroundColor="#24242E"
                    android:textColor="@android:color/white" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Brand Selector Chips (Visible on UAD tab) -->
        <HorizontalScrollView
            android:id="@+id/scrollBrandChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupBrands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandAuto"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Auto Detected"
                    android:checked="true"
                    app:chipBackgroundColor="#1A2836"
                    android:textColor="#00E5FF" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Brands"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandNothing"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nothing OS"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandGoogle"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandXiaomi"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xiaomi / HyperOS"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandSamsung"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung OneUI"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandBbk"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OnePlus / BBK"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBrandCarrier"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carrier / Meta"
                    app:chipBackgroundColor="#1E1E26"
                    android:textColor="@android:color/white" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Count & Batch Buttons Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvBloatCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scanning bloatware..."
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplySafeDebloat"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚡ 1-TAP DEBLOAT SAFE"
                android:textSize="11sp"
                android:backgroundTint="#FF1744"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreAllUndo"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔄 RESTORE ALL"
                android:textSize="11sp"
                android:backgroundTint="#00E676"
                android:textColor="@android:color/black"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBloatApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/pbBloatLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="No bloatware packages found."
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
