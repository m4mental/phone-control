<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTouch"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Touch Response"
        app:titleTextColor="@color/color_touch"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/color_touch" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/color_touch"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Per-App Optimization Only"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To save battery, Touch Response Booster can now only be enabled for specific apps.\n\nPlease go to 'Per-App Configuration' on the main dashboard to enable this for your games or favorite apps."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</LinearLayout>
