<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarModeControl"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Operating Mode Control"
        app:titleTextColor="@color/color_mode"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/color_mode" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Performance Profile"
                android:textColor="@android:color/white"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#121212"
                app:strokeWidth="1dp"
                app:strokeColor="#333333">

                <RadioGroup
                    android:id="@+id/rgModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rbPowerSaver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Manual: Power Saver\nMax battery life. Limits high CPU clocks, sets 60Hz display, and restricts background."
                        android:textColor="@android:color/white"
                        android:buttonTint="@color/color_mode"
                        android:textSize="14sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

                    <RadioButton
                        android:id="@+id/rbBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Manual: Balanced\nStable Kernel params. Dynamic scaling. Multi-tasking optimized (Best for Daily Use)."
                        android:textColor="@android:color/white"
                        android:buttonTint="@color/color_mode"
                        android:textSize="14sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

                    <RadioButton
                        android:id="@+id/rbPerformance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Manual: Performance\nUnlocks GPU floor. Max I/O (2048KB). 120Hz smooth UI response (Best for Gaming)."
                        android:textColor="@android:color/white"
                        android:buttonTint="@color/color_mode"
                        android:textSize="14sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" />

                    <RadioButton
                        android:id="@+id/rbAutomatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Automatic (AI Engine)\nDynamically tunes CPU speed and responsiveness based on real-time app load."
                        android:textColor="@android:color/white"
                        android:buttonTint="@color/color_mode"
                        android:textSize="14sp" />

                    <!-- AI Sub-settings -->
                    <LinearLayout
                        android:id="@+id/layoutFocusSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Automatic Focus Selection:"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rgFocus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:id="@+id/rbFocusBattery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Battery Saver Focus\nPrioritize efficiency, boost only when needed."
                                android:textColor="@android:color/white"
                                android:buttonTint="@color/color_mode"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbFocusDaily"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Daily Usage Focus\nSmart balance between speed and battery."
                                android:textColor="@android:color/white"
                                android:buttonTint="@color/color_mode"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbFocusMultitasking"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Multitasking Focus\nDynamic performance for heavy multitasking."
                                android:textColor="@android:color/white"
                                android:buttonTint="@color/color_mode"
                                android:textSize="13sp" />
                        </RadioGroup>
                    </LinearLayout>
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Unified Shortcut to Custom Refresh Rate -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDisplayRefreshShortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#001824"
                app:strokeWidth="1dp"
                app:strokeColor="#00E5FF"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="#00E5FF" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom Display Refresh Rate"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvCurrentRefreshSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Current: Dynamic (Auto)"
                            android:textColor="#80DEEA"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUSTOMIZE →"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
