<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBackupList"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Backup Applications"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@android:color/white" />

    <EditText
        android:id="@+id/etSearchBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search installed apps..."
        android:textColor="@android:color/white"
        android:textColorHint="#555555"
        android:padding="12dp"
        android:background="#161616"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:inputType="text" />

    <!-- Top Multi-Selection Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:background="#121212"
        android:layout_marginTop="8dp">

        <CheckBox
            android:id="@+id/cbSelectAllBackup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:buttonTint="@color/color_battery" />

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0 selected"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvBackupApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1E1E1E"
        android:dividerHeight="1dp" />

    <!-- Bottom Action Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#121212">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackupSelected"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="⚡ BACKUP SELECTED (0 APPS)"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            app:backgroundTint="@color/color_battery"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
