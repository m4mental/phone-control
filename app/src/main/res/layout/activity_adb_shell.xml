<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAdb"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Root Terminal (PRO)"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@android:color/white">

        <ImageButton
            android:id="@+id/btnCopyOutput"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_save"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy Output"
            app:tint="#00E676" />

        <ImageButton
            android:id="@+id/btnShareLog"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_share"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share Log"
            app:tint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppList"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="APPS"
            android:textColor="@android:color/white"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconTint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnProcessMonitor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Live Monitor"
            app:tint="#00E5FF" />

        <ImageButton
            android:id="@+id/btnShowTips"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Help Tips"
            app:tint="#FFD700" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Terminal Console Output View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:background="#0A0A0C">

        <TextView
            android:id="@+id/tvAdbOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="root@phonecontrol:~# "
            android:textColor="#00FF00"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Pro Hacker Symbol / Helper Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16161A"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutHackerBar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <Button
                android:id="@+id/btnKeyHistoryUp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="▲"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKeyHistoryDown"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="▼"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKeyPipe"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="|"
                android:textColor="#FFD700"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKeySlash"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="/"
                android:textColor="#FFD700"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKeyGrep"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="grep"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKeyPs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ps -A"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKeyDumpsys"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="dumpsys"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKeyLogcat"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="logcat -d"
                android:textColor="#FF80AB"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKeyClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="CLEAR"
                android:textColor="#FF5252"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Terminal Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E1E24"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# "
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <EditText
            android:id="@+id/etAdbInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter root command..."
            android:textColor="@android:color/white"
            android:textColorHint="#666666"
            android:background="@android:color/transparent"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="History"
            app:tint="#888888" />

        <ImageButton
            android:id="@+id/btnSendAdb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Run"
            app:tint="#00E676" />
    </LinearLayout>

    <!-- Fast Action Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:background="#101014"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLiveStats"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 8-Core Live Snapshot"
                android:textColor="#00E5FF"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGetProp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Specs (getprop)"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLs"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ls /data/data"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUptime"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uptime &amp; Load"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnableApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable App"
                android:textColor="@color/color_per_app"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDisableApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disable App"
                android:textColor="@color/color_battery"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeleteApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete App"
                android:textColor="#FF1744"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUfs"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UFS Storage Health"
                android:textColor="#00E5FF"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNet"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G / LTE Stats"
                android:textColor="#76FF03"
                android:layout_marginEnd="6dp" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
