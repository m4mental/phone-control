<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAdb"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Root Terminal (ADB)"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@android:color/white">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppList"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="APPS"
            android:textColor="@android:color/white"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconTint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnProcessMonitor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#00FF00" />

        <ImageButton
            android:id="@+id/btnShowTips"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" />

    </com.google.android.material.appbar.MaterialToolbar>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Execute shell commands with root privileges. Be careful with what you run."
        android:textColor="#888888"
        android:textSize="12sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:background="#0D0D0D">

        <TextView
            android:id="@+id/tvAdbOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="localhost:~# "
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etAdbInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter command..."
            android:textColor="@android:color/white"
            android:textColorHint="#444444"
            android:background="@android:color/transparent"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#888888" />

        <ImageButton
            android:id="@+id/btnSendAdb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Quick Commands -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#121212">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipGetProp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="getprop"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLs"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ls /data"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipUptime"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="uptime"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnableApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable Any App"
                android:textColor="@color/color_per_app"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDisableApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disable Any App"
                android:textColor="@color/color_battery"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeleteApp"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete Any App"
                android:textColor="#FF1744"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipUfs"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UFS Health"
                android:textColor="#00E5FF"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipNet"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Net Stats"
                android:textColor="#76FF03"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipClear"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="clear"
                android:textColor="#FF4444" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
